# 이 파일을 복사해서 .env.local 로 만들고 값을 채운다:  cp env.example .env.local
# .env.local 은 .gitignore 에 들어 있어서 GitHub에 안 올라간다. 이 파일(env.example)에는 진짜 키를 쓰지 마라.

# OpenAI (Step 2)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Supabase (Step 3) - URL은 프로젝트 화면 위쪽 Connect 버튼, secret 키는 Settings > API Keys > Secret keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
